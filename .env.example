APP_NAME=SOPH.IA
ENVIRONMENT=development
SECRET_KEY=troque-esta-chave-em-producao
SEED_ADMIN_EMAIL=admin@sophia.ro.gov.br
SEED_ADMIN_PASSWORD=defina-uma-senha-forte
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=sqlite:///./data/sophia.db
# Docker/PostgreSQL:
# DATABASE_URL=postgresql+psycopg://sophia:sophia@db:5432/sophia
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=./uploads
AI_PROVIDER=template
# O Gemini é configurado com segurança pela tela Administração > Inteligência Artificial.
# Não exponha chaves em variáveis VITE_ ou no código do frontend.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
WEB_SEARCH_ENABLED=true
# Necessária apenas para a pesquisa oficial via Ollama Web Search:
OLLAMA_API_KEY=
WEB_ALLOWED_DOMAINS=gov.br,planalto.gov.br,tcu.gov.br,cgu.gov.br,compras.gov.br,rondonia.ro.gov.br
WEB_SEARCH_MAX_RESULTS=4
WEB_SEARCH_TIMEOUT_SECONDS=20
VITE_API_URL=http://localhost:8000/api
